
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile and Run with Files",
            "type": "shell",
            "command": "g++ -std=c++17 -O2 -Wall \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\"; if ($LASTEXITCODE -eq 0) { Get-Content \"${fileDirname}\\input.txt\" | & \"${fileDirname}\\${fileBasenameNoExtension}.exe\" | Out-File -FilePath \"${fileDirname}\\output.txt\" -Encoding utf8 }",
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "focus": false,
                "echo": false,
                "showReuseMessage": false,
                "clear": true
            }
        }
    ]
}
